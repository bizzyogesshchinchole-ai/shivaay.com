rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read on product catalog, reviews, coupons, articles, categories and store settings
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /coupons/{couponCode} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: allow customer creation, order tracking lookup, and admin management
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Customers: allow account creation, login profile sync, and profile updates
    match /customers/{customerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }
  }
}
